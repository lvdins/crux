{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crux",
  "version": "0.1.14",
  "identifier": "com.giraffe360.qualitylab",
  "build": {
    "beforeDevCommand": "npm run dev -w client",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build -w client",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crux",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
