{
  "name": "crux",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "app:dev": "tauri dev",
    "app:build": "tauri build --config src-tauri/tauri.bundle.json",
    "tauri": "tauri",
    "bundle:server": "node scripts/bundle-server.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.1.0"
  }
}
